{
  "id": "combined/cc/conflict-resolved",
  "title": "git show of a merge that resolved a conflict by hand",
  "description": null,
  "tier": "combined",
  "tags": ["combined"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","show","--format=","<state3>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": false,
    "git_apply_numstat": false
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "combined": true,
        "status": "modified",
        "path": "f.txt",
        "old_name": "a/f.txt",
        "new_name": "b/f.txt",
        "parents": 2,
        "binary": false,
        "hunks": [
          {
            "parent_ranges": [{"start":1,"lines":7},{"start":1,"lines":7}],
            "new_start": 1,
            "new_lines": 7,
            "section": "",
            "lines": [
              {"markers":"  ","text":"1"},
              {"markers":"  ","text":"2"},
              {"markers":"  ","text":"3"},
              {"markers":"- ","text":"four (ours)"},
              {"markers":" -","text":"four (theirs)"},
              {"markers":"++","text":"four (both)"},
              {"markers":"  ","text":"5"},
              {"markers":"  ","text":"6"},
              {"markers":"  ","text":"7"}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "skip": "a combined diff describes a merge, it is not a patch"
  },
  "recipe": {
    "kind": "git-merge",
    "args": [
      "--format="
    ],
    "parents": [[],[0],[0],[1,2]],
    "states": [
      {
        "message": "base",
        "files": [
          {"path":"f.txt","content":"1\n2\n3\n4\n5\n6\n7\n8\n"}
        ]
      },
      {
        "message": "ours",
        "files": [
          {"path":"f.txt","content":"1\n2\n3\nfour (ours)\n5\n6\n7\n8\n"}
        ]
      },
      {
        "message": "theirs",
        "files": [
          {"path":"f.txt","content":"1\n2\n3\nfour (theirs)\n5\n6\n7\n8\n"}
        ]
      },
      {
        "message": "Merge theirs into ours",
        "files": [
          {"path":"f.txt","content":"1\n2\n3\nfour (both)\n5\n6\n7\n8\n"}
        ]
      }
    ]
  },
  "source": "scenarios/85-combined.js"
}
