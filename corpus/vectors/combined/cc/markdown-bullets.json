{
  "id": "combined/cc/markdown-bullets",
  "title": "A merge that drops \"- item\" bullets and adds \"+ item\" bullets: \"--- item\" and \"+++ item\"",
  "description": "In a two-parent combined diff a line removed from both parents begins with \"--\" and a line new to both begins with \"++\".",
  "tier": "combined",
  "tags": ["combined","content-lookalike","fake-file-header"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","show","--format=","<state3>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": false,
    "git_apply_numstat": false
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "combined": true,
        "status": "modified",
        "path": "list.md",
        "old_name": "a/list.md",
        "new_name": "b/list.md",
        "parents": 2,
        "binary": false,
        "hunks": [
          {
            "parent_ranges": [{"start":1,"lines":6},{"start":1,"lines":6}],
            "new_start": 1,
            "new_lines": 7,
            "section": "",
            "lines": [
              {"markers":"  ","text":"# Shopping"},
              {"markers":"  ","text":""},
              {"markers":"  ","text":"- apples"},
              {"markers":"--","text":"- bread"},
              {"markers":"++","text":"+ flour"},
              {"markers":"  ","text":"- cheese"},
              {"markers":" +","text":"- dates"},
              {"markers":"+ ","text":"- eggs"}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "skip": "a combined diff describes a merge, it is not a patch"
  },
  "recipe": {
    "kind": "git-merge",
    "args": [
      "--format="
    ],
    "parents": [[],[0],[0],[1,2]],
    "states": [
      {
        "message": "base",
        "files": [
          {"path":"list.md","content":"# Shopping\n\n- apples\n- bread\n- cheese\n"}
        ]
      },
      {
        "message": "ours",
        "files": [
          {"path":"list.md","content":"# Shopping\n\n- apples\n- bread\n- cheese\n- dates\n"}
        ]
      },
      {
        "message": "theirs",
        "files": [
          {"path":"list.md","content":"# Shopping\n\n- apples\n- bread\n- cheese\n- eggs\n"}
        ]
      },
      {
        "message": "Merge",
        "files": [
          {"path":"list.md","content":"# Shopping\n\n- apples\n+ flour\n- cheese\n- dates\n- eggs\n"}
        ]
      }
    ]
  },
  "source": "scenarios/85-combined.js"
}
