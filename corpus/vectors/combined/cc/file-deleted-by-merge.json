{
  "id": "combined/cc/file-deleted-by-merge",
  "title": "A file that both parents have and the merge removes",
  "description": null,
  "tier": "combined",
  "tags": ["combined","deleted"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","show","--format=","<state3>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": false,
    "git_apply_numstat": false
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "combined": true,
        "status": "deleted",
        "path": "old.txt",
        "old_name": "a/old.txt",
        "new_name": null,
        "parents": 2,
        "binary": false,
        "hunks": [
          {
            "parent_ranges": [{"start":1,"lines":2},{"start":1,"lines":2}],
            "new_start": 1,
            "new_lines": 0,
            "section": "",
            "lines": [
              {"markers":"--","text":"one"},
              {"markers":"--","text":"two"}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "skip": "a combined diff describes a merge, it is not a patch"
  },
  "recipe": {
    "kind": "git-merge",
    "args": [
      "--format="
    ],
    "parents": [[],[0],[0],[1,2]],
    "states": [
      {
        "message": "base",
        "files": [
          {"path":"a.txt","content":"a\n"},
          {"path":"old.txt","content":"one\ntwo\n"}
        ]
      },
      {
        "message": "ours",
        "files": [
          {"path":"a.txt","content":"A\n"},
          {"path":"old.txt","content":"one\ntwo\n"}
        ]
      },
      {
        "message": "theirs",
        "files": [
          {"path":"a.txt","content":"a\n"},
          {"path":"old.txt","content":"one\ntwo\n"},
          {"path":"b.txt","content":"b\n"}
        ]
      },
      {
        "message": "Merge",
        "files": [
          {"path":"a.txt","content":"A\n"},
          {"path":"b.txt","content":"b\n"}
        ]
      }
    ]
  },
  "source": "scenarios/85-combined.js"
}
