{
  "id": "git/paths/emoji-and-space-quoted",
  "title": "An emoji and a space: quoted, and the TAB follows the closing quote",
  "description": "The space puts a TAB at the end of the \"---\" and \"+++\" lines whether or not the name is quoted. The name ends at its closing quote.",
  "tier": "git",
  "tags": ["paths","quoted-path","unicode","space-in-path"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/emoji 🎉.txt",
        "new_name": "b/emoji 🎉.txt",
        "old_path": "emoji 🎉.txt",
        "new_path": "emoji 🎉.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"old","old_no":1,"new_no":null},
              {"type":"add","text":"new","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"emoji 🎉.txt","content":"old\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"emoji 🎉.txt","content":"new\n"}
        ]
      }
    ]
  },
