{
  "id": "git/paths/quoted-name-with-space-added",
  "title": "A new file whose name is quoted and contains a space",
  "description": "The \"+++\" line is the only one with the name on it that a plain patch reader looks at, and it ends in a quote and a TAB. Taking the rest of the line as the name creates a file called `\\303\\234bersicht 2024.txt\"<TAB>`.",
  "tier": "git",
  "tags": ["paths","quoted-path","unicode","space-in-path","added"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "added",
        "old_name": null,
        "new_name": "b/Übersicht 2024.txt",
        "old_path": null,
        "new_path": "Übersicht 2024.txt",
        "old_mode": null,
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 0,
        "hunks": [
          {
            "old_start": 0,
            "old_lines": 0,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"add","text":"Januar","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": []
      },
      {
        "message": "state 1",
        "files": [
          {"path":"Übersicht 2024.txt","content":"Januar\n"}
        ]
      }
    ]
  },
  "source": "scenarios/50-paths.js"
}
