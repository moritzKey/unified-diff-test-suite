{
  "id": "git/paths/trailing-space-empty-added",
  "title": "A new empty file whose name ends with a space: only \"diff --git\" names it",
  "description": "An empty new file has no \"+++\" line, and nothing after the name on the header line marks where it ends.",
  "tier": "git",
  "tags": ["paths","space-in-path","added","empty-file","no-hunks"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "added",
        "old_name": null,
        "new_name": "b/empty ",
        "old_path": null,
        "new_path": "empty ",
        "old_mode": null,
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 0,
        "deletions": 0,
        "hunks": []
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"keep.txt","content":"k\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"keep.txt","content":"k\n"},
          {"path":"empty ","content":""}
        ]
      }
    ]
  },
  "source": "scenarios/50-paths.js"
}
