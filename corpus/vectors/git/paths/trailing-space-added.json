{
  "id": "git/paths/trailing-space-added",
  "title": "A new file whose name ends with a space, next to the same name without it",
  "description": "A program that trims the name of a new file writes it over the other file.",
  "tier": "git",
  "tags": ["paths","space-in-path","added"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "added",
        "old_name": null,
        "new_name": "b/notes.txt ",
        "old_path": null,
        "new_path": "notes.txt ",
        "old_mode": null,
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 0,
        "hunks": [
          {
            "old_start": 0,
            "old_lines": 0,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"add","text":"new","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"notes.txt","content":"keep me\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"notes.txt","content":"keep me\n"},
          {"path":"notes.txt ","content":"new\n"}
        ]
      }
    ]
  },
  "source": "scenarios/50-paths.js"
}
