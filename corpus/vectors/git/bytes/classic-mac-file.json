{
  "id": "git/bytes/classic-mac-file",
  "title": "A file that uses CR as its only line terminator is one long line without a final newline",
  "description": null,
  "tier": "git",
  "tags": ["line-endings","cr","line-splitting","no-newline"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/old-mac.txt",
        "new_name": "b/old-mac.txt",
        "old_path": "old-mac.txt",
        "new_path": "old-mac.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"one\rtwo\rthree\r","old_no":1,"new_no":null,"no_newline":true},
              {"type":"add","text":"one\rTWO\rthree\r","old_no":null,"new_no":1,"no_newline":true}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"old-mac.txt","content":"one\rtwo\rthree\r"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"old-mac.txt","content":"one\rTWO\rthree\r"}
        ]
      }
    ]
  },
  "source": "scenarios/45-bytes.js"
}
