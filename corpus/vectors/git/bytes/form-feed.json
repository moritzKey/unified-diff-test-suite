{
  "id": "git/bytes/form-feed",
  "title": "Form feed (page break) characters inside lines",
  "description": "Common in older C, Emacs Lisp and Python sources. str.splitlines() in Python treats U+000C as a line boundary.",
  "tier": "git",
  "tags": ["control-chars","line-splitting"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/paged.el",
        "new_name": "b/paged.el",
        "old_path": "paged.el",
        "new_path": "paged.el",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 2,
        "deletions": 2,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 4,
            "new_start": 1,
            "new_lines": 4,
            "section": "",
            "lines": [
              {"type":"context","text":";;; a","old_no":1,"new_no":1},
              {"type":"delete","text":"\f","old_no":2,"new_no":null},
              {"type":"add","text":"\f;;; page two","old_no":null,"new_no":2},
              {"type":"context","text":";;; b","old_no":3,"new_no":3},
              {"type":"delete","text":"(provide 'x)","old_no":4,"new_no":null},
              {"type":"add","text":"(provide 'y)\f","old_no":null,"new_no":4}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"paged.el","content":";;; a\n\f\n;;; b\n(provide 'x)\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"paged.el","content":";;; a\n\f;;; page two\n;;; b\n(provide 'y)\f\n"}
        ]
      }
    ]
  },
  "source": "scenarios/45-bytes.js"
}
