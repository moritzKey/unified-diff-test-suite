{
  "id": "git/bytes/latin1-content",
  "title": "Content that is not valid UTF-8 (ISO-8859-1)",
  "description": "git does not care about encodings; the diff carries the bytes as they are. A parser that insists on UTF-8 fails or silently replaces bytes.",
  "tier": "git",
  "tags": ["non-utf8","encoding"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": false,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/legacy.txt",
        "new_name": "b/legacy.txt",
        "old_path": "legacy.txt",
        "new_path": "legacy.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 2,
            "new_start": 1,
            "new_lines": 2,
            "section": "",
            "lines": [
              {"type":"delete","text":{"base64":"R3L832U="},"old_no":1,"new_no":null},
              {"type":"add","text":{"base64":"R3L832Uh"},"old_no":null,"new_no":1},
              {"type":"context","text":"end","old_no":2,"new_no":2}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"legacy.txt","content":{"base64":"R3L832UKZW5kCg=="}}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"legacy.txt","content":{"base64":"R3L832UhCmVuZAo="}}
        ]
      }
    ]
  },
  "source": "scenarios/45-bytes.js"
}
