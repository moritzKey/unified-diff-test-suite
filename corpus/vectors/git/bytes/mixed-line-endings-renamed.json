{
  "id": "git/bytes/mixed-line-endings-renamed",
  "title": "A file with mixed line endings renamed without a change: no hunks to see them in",
  "description": null,
  "tier": "git",
  "tags": ["line-endings","cr","rename","no-hunks"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "renamed",
        "old_name": "a/old.txt",
        "new_name": "b/new.txt",
        "old_path": "old.txt",
        "new_path": "new.txt",
        "old_mode": null,
        "new_mode": null,
        "similarity": 100,
        "binary": false,
        "additions": 0,
        "deletions": 0,
        "hunks": []
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"old.txt","content":"a\nb\r\nc\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"new.txt","content":"a\nb\r\nc\n"}
        ]
      }
    ]
  },
  "source": "scenarios/45-bytes.js"
}
