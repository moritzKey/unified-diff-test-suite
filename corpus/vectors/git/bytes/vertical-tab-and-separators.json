{
  "id": "git/bytes/vertical-tab-and-separators",
  "title": "VT, FS, GS, RS and US control characters inside lines",
  "description": null,
  "tier": "git",
  "tags": ["control-chars","line-splitting"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/ctl.txt",
        "new_name": "b/ctl.txt",
        "old_path": "ctl.txt",
        "new_path": "ctl.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 5,
        "deletions": 5,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 5,
            "new_start": 1,
            "new_lines": 5,
            "section": "",
            "lines": [
              {"type":"delete","text":"a\u000bb","old_no":1,"new_no":null},
              {"type":"delete","text":"c\u001cd","old_no":2,"new_no":null},
              {"type":"delete","text":"e\u001df","old_no":3,"new_no":null},
              {"type":"delete","text":"g\u001eh","old_no":4,"new_no":null},
              {"type":"delete","text":"i\u001fj","old_no":5,"new_no":null},
              {"type":"add","text":"a\u000bB","old_no":null,"new_no":1},
              {"type":"add","text":"c\u001cD","old_no":null,"new_no":2},
              {"type":"add","text":"e\u001dF","old_no":null,"new_no":3},
              {"type":"add","text":"g\u001eH","old_no":null,"new_no":4},
              {"type":"add","text":"i\u001fJ","old_no":null,"new_no":5}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"ctl.txt","content":"a\u000bb\nc\u001cd\ne\u001df\ng\u001eh\ni\u001fj\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"ctl.txt","content":"a\u000bB\nc\u001cD\ne\u001dF\ng\u001eH\ni\u001fJ\n"}
        ]
      }
    ]
  },
  "source": "scenarios/45-bytes.js"
}
