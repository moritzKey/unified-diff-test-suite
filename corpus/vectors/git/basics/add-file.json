{
  "id": "git/basics/add-file",
  "title": "A new file",
  "description": "The old side is /dev/null and the hunk header reads \"-0,0\".",
  "tier": "git",
  "tags": ["basics","added"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "added",
        "old_name": null,
        "new_name": "b/new.txt",
        "old_path": null,
        "new_path": "new.txt",
        "old_mode": null,
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 3,
        "deletions": 0,
        "hunks": [
          {
            "old_start": 0,
            "old_lines": 0,
            "new_start": 1,
            "new_lines": 3,
            "section": "",
            "lines": [
              {"type":"add","text":"first","old_no":null,"new_no":1},
              {"type":"add","text":"second","old_no":null,"new_no":2},
              {"type":"add","text":"third","old_no":null,"new_no":3}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"keep.txt","content":"keep\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"keep.txt","content":"keep\n"},
          {"path":"new.txt","content":"first\nsecond\nthird\n"}
        ]
      }
    ]
  },
  "source": "scenarios/10-basics.js"
}
