{
  "id": "git/basics/blank-added-and-deleted-lines",
  "title": "Adding or deleting an empty line gives a bare \"+\" or \"-\"",
  "description": "The whole diff line is one character long. Parsers that skip \"empty-looking\" lines or trim lines lose them.",
  "tier": "git",
  "tags": ["basics","blank-lines"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/spacing.txt",
        "new_name": "b/spacing.txt",
        "old_path": "spacing.txt",
        "new_path": "spacing.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 2,
        "deletions": 2,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 6,
            "new_start": 1,
            "new_lines": 6,
            "section": "",
            "lines": [
              {"type":"context","text":"a","old_no":1,"new_no":1},
              {"type":"delete","text":"","old_no":2,"new_no":null},
              {"type":"delete","text":"","old_no":3,"new_no":null},
              {"type":"context","text":"b","old_no":4,"new_no":2},
              {"type":"context","text":"c","old_no":5,"new_no":3},
              {"type":"add","text":"","old_no":null,"new_no":4},
              {"type":"add","text":"","old_no":null,"new_no":5},
              {"type":"context","text":"d","old_no":6,"new_no":6}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"spacing.txt","content":"a\n\n\nb\nc\nd\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"spacing.txt","content":"a\nb\nc\n\n\nd\n"}
        ]
      }
    ]
  },
  "source": "scenarios/10-basics.js"
}
