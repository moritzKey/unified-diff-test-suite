{
  "id": "git/content/timestamp-like-lines",
  "title": "Content lines that look like GNU diff headers with timestamps",
  "description": null,
  "tier": "git",
  "tags": ["content-lookalike","fake-file-header"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/paste.txt",
        "new_name": "b/paste.txt",
        "old_path": "paste.txt",
        "new_path": "paste.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 3,
            "new_start": 1,
            "new_lines": 3,
            "section": "",
            "lines": [
              {"type":"context","text":"x","old_no":1,"new_no":1},
              {"type":"delete","text":"-- a/file.c\t2024-01-01 10:00:00.000000000 +0100","old_no":2,"new_no":null},
              {"type":"add","text":"++ b/file.c\t2024-01-02 11:00:00.000000000 +0100","old_no":null,"new_no":2},
              {"type":"context","text":"y","old_no":3,"new_no":3}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"paste.txt","content":"x\n-- a/file.c\t2024-01-01 10:00:00.000000000 +0100\ny\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"paste.txt","content":"x\n++ b/file.c\t2024-01-02 11:00:00.000000000 +0100\ny\n"}
        ]
      }
    ]
  },
  "source": "scenarios/30-content.js"
}
