{
  "id": "git/content/markdown-rule-and-front-matter",
  "title": "Markdown front matter and rules: lines of \"---\" added and deleted",
  "description": "A deleted \"---\" becomes \"----\", an added one \"+---\".",
  "tier": "git",
  "tags": ["content-lookalike"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/post.md",
        "new_name": "b/post.md",
        "old_path": "post.md",
        "new_path": "post.md",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 2,
        "deletions": 5,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 9,
            "new_start": 1,
            "new_lines": 6,
            "section": "",
            "lines": [
              {"type":"delete","text":"---","old_no":1,"new_no":null},
              {"type":"delete","text":"title: Old","old_no":2,"new_no":null},
              {"type":"delete","text":"---","old_no":3,"new_no":null},
              {"type":"add","text":"title: New","old_no":null,"new_no":1},
              {"type":"context","text":"","old_no":4,"new_no":2},
              {"type":"context","text":"Text","old_no":5,"new_no":3},
              {"type":"context","text":"","old_no":6,"new_no":4},
              {"type":"delete","text":"---","old_no":7,"new_no":null},
              {"type":"delete","text":"","old_no":8,"new_no":null},
              {"type":"context","text":"More","old_no":9,"new_no":5},
              {"type":"add","text":"---","old_no":null,"new_no":6}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"post.md","content":"---\ntitle: Old\n---\n\nText\n\n---\n\nMore\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"post.md","content":"title: New\n\nText\n\nMore\n---\n"}
        ]
      }
    ]
  },
  "source": "scenarios/30-content.js"
}
