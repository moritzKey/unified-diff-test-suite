{
  "id": "git/ops/copy-pure",
  "title": "A copy (-C --find-copies-harder): \"copy from\"/\"copy to\", no hunks",
  "description": null,
  "tier": "git",
  "tags": ["copy","no-hunks"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","-C","--find-copies-harder","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "copied",
        "old_name": "a/template.txt",
        "new_name": "b/instance.txt",
        "old_path": "template.txt",
        "new_path": "instance.txt",
        "old_mode": null,
        "new_mode": null,
        "similarity": 100,
        "binary": false,
        "additions": 0,
        "deletions": 0,
        "hunks": []
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [
      "-C",
      "--find-copies-harder"
    ],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"template.txt","content":"line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"template.txt","content":"line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\n"},
          {"path":"instance.txt","content":"line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\n"}
        ]
      }
    ]
  },
  "source": "scenarios/60-operations.js"
}
