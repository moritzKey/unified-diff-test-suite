{
  "id": "git/ops/file-becomes-symlink",
  "title": "A regular file replaced by a symbolic link: two sections for one path",
  "description": "A type change is written as a deletion followed by an addition of the same path.",
  "tier": "git",
  "tags": ["symlink","typechange","added","deleted"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "deleted",
        "old_name": "a/config",
        "new_name": null,
        "old_path": "config",
        "new_path": null,
        "old_mode": "100644",
        "new_mode": null,
        "similarity": null,
        "binary": false,
        "additions": 0,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 0,
            "new_lines": 0,
            "section": "",
            "lines": [
              {"type":"delete","text":"value = 1","old_no":1,"new_no":null}
            ]
          }
        ]
      },
      {
        "status": "added",
        "old_name": null,
        "new_name": "b/config",
        "old_path": null,
        "new_path": "config",
        "old_mode": null,
        "new_mode": "120000",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 0,
        "hunks": [
          {
            "old_start": 0,
            "old_lines": 0,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"add","text":"config.default","old_no":null,"new_no":1,"no_newline":true}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"config","content":"value = 1\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"config","content":"config.default","mode":"120000"}
        ]
      }
    ]
  },
  "source": "scenarios/60-operations.js"
}
