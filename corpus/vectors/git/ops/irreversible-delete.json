{
  "id": "git/ops/irreversible-delete",
  "title": "git diff -D: a deletion without its content",
  "description": "\"deleted file mode\" and an index line, but neither \"---\"/\"+++\" nor a hunk.",
  "tier": "git",
  "tags": ["deleted","no-hunks"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","-D","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "deleted",
        "old_name": "a/gone.txt",
        "new_name": null,
        "old_path": "gone.txt",
        "new_path": null,
        "old_mode": "100644",
        "new_mode": null,
        "similarity": null,
        "binary": false,
        "additions": 0,
        "deletions": 0,
        "hunks": []
      },
      {
        "status": "modified",
        "old_name": "a/stay.txt",
        "new_name": "b/stay.txt",
        "old_path": "stay.txt",
        "new_path": "stay.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"1","old_no":1,"new_no":null},
              {"type":"add","text":"2","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "skip": "made with -D, which leaves out what a deletion removes"
  },
  "recipe": {
    "kind": "git-diff",
    "args": [
      "-D"
    ],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"gone.txt","content":"a\nb\nc\n"},
          {"path":"stay.txt","content":"1\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"stay.txt","content":"2\n"}
        ]
      }
    ]
  },
  "source": "scenarios/60-operations.js"
}
