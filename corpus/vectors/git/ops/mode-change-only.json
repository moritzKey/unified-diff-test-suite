  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"run.sh","content":"#!/bin/sh\necho hi\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"run.sh","content":"#!/bin/sh\necho hi\n","mode":"100755"}
