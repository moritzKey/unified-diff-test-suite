{
  "id": "git/ops/rename-executable",
  "title": "An executable file renamed, its mode unchanged",
  "description": "A rename that keeps the mode has no mode line: the new file is executable because the old one was.",
  "tier": "git",
  "tags": ["rename","mode","no-hunks"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "renamed",
        "old_name": "a/build.sh",
        "new_name": "b/make.sh",
        "old_path": "build.sh",
        "new_path": "make.sh",
        "old_mode": null,
        "new_mode": null,
        "similarity": 100,
        "binary": false,
        "additions": 0,
        "deletions": 0,
        "hunks": []
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"build.sh","content":"line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\n","mode":"100755"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"make.sh","content":"line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\n","mode":"100755"}
        ]
      }
    ]
  },
  "source": "scenarios/60-operations.js"
}
