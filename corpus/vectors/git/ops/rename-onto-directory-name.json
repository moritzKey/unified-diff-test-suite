{
  "id": "git/ops/rename-onto-directory-name",
  "title": "A file renamed to the name of a directory whose only file is deleted",
  "description": "The rename section comes before the deletion that frees its target.",
  "tier": "git",
  "tags": ["rename","deleted"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "renamed",
        "old_name": "a/notes.txt",
        "new_name": "b/notes",
        "old_path": "notes.txt",
        "new_path": "notes",
        "old_mode": null,
        "new_mode": null,
        "similarity": 100,
        "binary": false,
        "additions": 0,
        "deletions": 0,
        "hunks": []
      },
      {
        "status": "deleted",
        "old_name": "a/notes/old.txt",
        "new_name": null,
        "old_path": "notes/old.txt",
        "new_path": null,
        "old_mode": "100644",
        "new_mode": null,
        "similarity": null,
        "binary": false,
        "additions": 0,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 0,
            "new_lines": 0,
            "section": "",
            "lines": [
              {"type":"delete","text":"gone","old_no":1,"new_no":null}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"notes.txt","content":"line one\nline two\nline three\n"},
          {"path":"notes/old.txt","content":"gone\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"notes","content":"line one\nline two\nline three\n"}
        ]
      }
    ]
  },
  "source": "scenarios/60-operations.js"
}
