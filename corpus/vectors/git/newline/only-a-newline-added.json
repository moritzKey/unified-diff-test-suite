{
  "id": "git/newline/only-a-newline-added",
  "title": "An empty file becomes a single empty line",
  "description": "The whole hunk body is one \"+\".",
  "tier": "git",
  "tags": ["no-newline","blank-lines","empty-file"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/f.txt",
        "new_name": "b/f.txt",
        "old_path": "f.txt",
        "new_path": "f.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 0,
        "hunks": [
          {
            "old_start": 0,
            "old_lines": 0,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"add","text":"","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"f.txt","content":""}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"f.txt","content":"\n"}
        ]
      }
    ]
  },
  "source": "scenarios/40-newline.js"
}
