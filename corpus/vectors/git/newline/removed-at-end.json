{
  "id": "git/newline/removed-at-end",
  "title": "The new file has no final newline, the old one had",
  "description": null,
  "tier": "git",
  "tags": ["no-newline"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/f.txt",
        "new_name": "b/f.txt",
        "old_path": "f.txt",
        "new_path": "f.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 2,
            "new_start": 1,
            "new_lines": 2,
            "section": "",
            "lines": [
              {"type":"context","text":"one","old_no":1,"new_no":1},
              {"type":"delete","text":"two","old_no":2,"new_no":null},
              {"type":"add","text":"two","old_no":null,"new_no":2,"no_newline":true}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"f.txt","content":"one\ntwo\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"f.txt","content":"one\ntwo"}
        ]
      }
    ]
  },
  "source": "scenarios/40-newline.js"
}
