{
  "id": "git/newline/u0-marker",
  "title": "-U0 with a marker on the only line of the hunk",
  "description": null,
  "tier": "git",
  "tags": ["no-newline","u0"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","-U0","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/f.txt",
        "new_name": "b/f.txt",
        "old_path": "f.txt",
        "new_path": "f.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 7,
            "old_lines": 1,
            "new_start": 7,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"last","old_no":7,"new_no":null,"no_newline":true},
              {"type":"add","text":"LAST","old_no":null,"new_no":7,"no_newline":true}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [
      "-U0"
    ],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"f.txt","content":"1\n2\n3\n4\n5\n6\nlast"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"f.txt","content":"1\n2\n3\n4\n5\n6\nLAST"}
        ]
      }
    ]
  },
  "source": "scenarios/40-newline.js"
}
