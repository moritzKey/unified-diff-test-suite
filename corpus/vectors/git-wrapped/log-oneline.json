        "hunks": [
          {
            "old_start": 0,
            "old_lines": 0,
            "new_start": 1,
            "new_lines": 3,
            "section": "",
            "lines": [
              {"type":"add","text":"import sys","old_no":null,"new_no":1},
              {"type":"add","text":"","old_no":null,"new_no":2},
