  "apply": {
    "skip": "several commits in one text"
  },
  "recipe": {
    "kind": "git-log",
    "args": [
      "--oneline"
    ],
    "states": [
      {
        "message": "Initial import",
        "files": [
          {"path":"app.py","content":"import sys\n\nprint(\"one\")\n"},
          {"path":"README","content":"readme\n"}
        ]
      },
      {
        "message": "Say two\n\nThe greeting is now a two.",
        "files": [
          {"path":"app.py","content":"import sys\n\nprint(\"two\")\n"},
          {"path":"README","content":"readme\n"}
        ]
      },
      {
        "message": "Add a changelog and say three",
        "files": [
          {"path":"app.py","content":"import sys\n\nprint(\"three\")\n"},
          {"path":"README","content":"readme\n"},
          {"path":"CHANGES","content":"- three\n"}
        ]
      }
    ]
  },
  "source": "scenarios/70-wrappers.js"
}
