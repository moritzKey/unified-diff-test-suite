  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/app.py",
        "new_name": "b/app.py",
        "old_path": "app.py",
        "new_path": "app.py",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 3,
            "new_start": 1,
            "new_lines": 3,
            "section": "",
            "lines": [
              {"type":"context","text":"import sys","old_no":1,"new_no":1},
              {"type":"context","text":"","old_no":2,"new_no":2},
              {"type":"delete","text":"print(\"one\")","old_no":3,"new_no":null},
              {"type":"add","text":"print(\"two\")","old_no":null,"new_no":3}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-format-patch",
    "args": [],
    "states": [
      {
        "message": "Initial import",
        "files": [
          {"path":"app.py","content":"import sys\n\nprint(\"one\")\n"},
          {"path":"README","content":"readme\n"}
        ]
      },
      {
        "message": "Say two\n\nThe greeting is now a two.",
        "files": [
          {"path":"app.py","content":"import sys\n\nprint(\"two\")\n"},
          {"path":"README","content":"readme\n"}
        ]
      }
    ]
