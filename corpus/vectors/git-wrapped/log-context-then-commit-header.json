{
  "id": "git-wrapped/log-context-then-commit-header",
  "title": "git log -p: the last hunk of a commit ends with context lines",
  "description": "What follows is the next commit header; a parser that reads \"until something that is not a diff line\" has to stop exactly here.",
  "tier": "git-wrapped",
  "tags": ["prelude","multiple-commits"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","log","-p","<state2>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/f.txt",
        "new_name": "b/f.txt",
        "old_path": "f.txt",
        "new_path": "f.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 6,
            "new_start": 1,
            "new_lines": 6,
            "section": "",
            "lines": [
              {"type":"context","text":"1","old_no":1,"new_no":1},
              {"type":"context","text":"two","old_no":2,"new_no":2},
              {"type":"delete","text":"3","old_no":3,"new_no":null},
              {"type":"add","text":"three","old_no":null,"new_no":3},
              {"type":"context","text":"4","old_no":4,"new_no":4},
              {"type":"context","text":"5","old_no":5,"new_no":5},
              {"type":"context","text":"6","old_no":6,"new_no":6}
            ]
          }
        ]
      },
      {
        "status": "modified",
        "old_name": "a/f.txt",
        "new_name": "b/f.txt",
        "old_path": "f.txt",
        "new_path": "f.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 5,
            "new_start": 1,
            "new_lines": 5,
            "section": "",
            "lines": [
              {"type":"context","text":"1","old_no":1,"new_no":1},
              {"type":"delete","text":"2","old_no":2,"new_no":null},
              {"type":"add","text":"two","old_no":null,"new_no":2},
              {"type":"context","text":"3","old_no":3,"new_no":3},
              {"type":"context","text":"4","old_no":4,"new_no":4},
              {"type":"context","text":"5","old_no":5,"new_no":5}
            ]
          }
        ]
      },
      {
        "status": "added",
        "old_name": null,
        "new_name": "b/f.txt",
        "old_path": null,
        "new_path": "f.txt",
        "old_mode": null,
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 8,
        "deletions": 0,
        "hunks": [
          {
            "old_start": 0,
            "old_lines": 0,
            "new_start": 1,
            "new_lines": 8,
            "section": "",
            "lines": [
              {"type":"add","text":"1","old_no":null,"new_no":1},
              {"type":"add","text":"2","old_no":null,"new_no":2},
              {"type":"add","text":"3","old_no":null,"new_no":3},
              {"type":"add","text":"4","old_no":null,"new_no":4},
              {"type":"add","text":"5","old_no":null,"new_no":5},
              {"type":"add","text":"6","old_no":null,"new_no":6},
              {"type":"add","text":"7","old_no":null,"new_no":7},
              {"type":"add","text":"8","old_no":null,"new_no":8}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "skip": "several commits in one text"
  },
  "recipe": {
    "kind": "git-log",
    "args": [],
    "states": [
      {
        "message": "one",
        "files": [
          {"path":"f.txt","content":"1\n2\n3\n4\n5\n6\n7\n8\n"}
        ]
      },
      {
        "message": "two",
        "files": [
          {"path":"f.txt","content":"1\ntwo\n3\n4\n5\n6\n7\n8\n"}
        ]
      },
      {
        "message": "three",
        "files": [
          {"path":"f.txt","content":"1\ntwo\nthree\n4\n5\n6\n7\n8\n"}
        ]
      }
    ]
  },
  "source": "scenarios/70-wrappers.js"
}
