{
  "id": "git-config/quotepath/off-still-quoted",
  "title": "core.quotePath=false: quotes, backslashes and control characters are still escaped",
  "description": "A quoted name can now contain raw non-ASCII bytes next to escapes: \"a/tab\\tü.txt\".",
  "tier": "git-config",
  "tags": ["quotepath-off","quoted-path","unicode","control-chars"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","<state0>","<state1>"],
    "config": {
      "core.quotePath": "false"
    }
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/q\"ü\".txt",
        "new_name": "b/q\"ü\".txt",
        "old_path": "q\"ü\".txt",
        "new_path": "q\"ü\".txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"a","old_no":1,"new_no":null},
              {"type":"add","text":"b","old_no":null,"new_no":1}
            ]
          }
        ]
      },
      {
        "status": "modified",
        "old_name": "a/tab\tü.txt",
        "new_name": "b/tab\tü.txt",
        "old_path": "tab\tü.txt",
        "new_path": "tab\tü.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"a","old_no":1,"new_no":null},
              {"type":"add","text":"b","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 1,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [],
    "config": {
      "core.quotePath": "false"
    },
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"tab\tü.txt","content":"a\n"},
          {"path":"q\"ü\".txt","content":"a\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"tab\tü.txt","content":"b\n"},
          {"path":"q\"ü\".txt","content":"b\n"}
        ]
      }
    ]
  },
  "source": "scenarios/80-config.js"
}
