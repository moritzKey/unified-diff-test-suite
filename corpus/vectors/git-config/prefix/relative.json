{
  "id": "git-config/prefix/relative",
  "title": "git diff --relative=src/: paths are relative to a subdirectory",
  "description": null,
  "tier": "git-config",
  "tags": ["prefix","relative"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","--relative=src/","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "a/",
    "new": "b/"
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/app.js",
        "new_name": "b/app.js",
        "old_path": "app.js",
        "new_path": "app.js",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"one","old_no":1,"new_no":null},
              {"type":"add","text":"two","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "skip": "made with --relative"
  },
  "recipe": {
    "kind": "git-diff",
    "args": [
      "--relative=src/"
    ],
    "relative": "src/",
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"src/app.js","content":"one\n"},
          {"path":"docs/readme.md","content":"r\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"src/app.js","content":"two\n"},
          {"path":"docs/readme.md","content":"R\n"}
        ]
      }
    ]
  },
  "source": "scenarios/80-config.js"
}
