{
  "id": "git-config/noprefix/directories-named-a-and-b",
  "title": "--no-prefix with real directories named \"a\" and \"b\"",
  "description": "\"--- a/readme.txt\" is the full path here. A parser that strips \"a/\" and \"b/\" on sight returns \"readme.txt\" for two different files.",
  "tier": "git-config",
  "tags": ["prefix","noprefix"],
  "producer": {
    "tool": "git",
    "version": "2.43.0",
    "argv": ["git","diff","--no-prefix","<state0>","<state1>"],
    "config": {}
  },
  "prefixes": {
    "old": "",
    "new": ""
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": true,
    "git_apply_numstat": true
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": true
  },
  "expected": {
    "files": [
      {
        "status": "modified",
        "old_name": "a/readme.txt",
        "new_name": "a/readme.txt",
        "old_path": "a/readme.txt",
        "new_path": "a/readme.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"one","old_no":1,"new_no":null},
              {"type":"add","text":"two","old_no":null,"new_no":1}
            ]
          }
        ]
      },
      {
        "status": "modified",
        "old_name": "b/readme.txt",
        "new_name": "b/readme.txt",
        "old_path": "b/readme.txt",
        "new_path": "b/readme.txt",
        "old_mode": "100644",
        "new_mode": "100644",
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"uno","old_no":1,"new_no":null},
              {"type":"add","text":"dos","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "from": 0,
    "to": 1,
    "strip": 0,
    "modes": true
  },
  "recipe": {
    "kind": "git-diff",
    "args": [
      "--no-prefix"
    ],
    "prefixes": [
      "",
      ""
    ],
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"a/readme.txt","content":"one\n"},
          {"path":"b/readme.txt","content":"uno\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"a/readme.txt","content":"two\n"},
          {"path":"b/readme.txt","content":"dos\n"}
        ]
      }
    ]
  },
  "source": "scenarios/80-config.js"
}
