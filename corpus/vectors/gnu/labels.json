{
  "id": "gnu/labels",
  "title": "diff -u --label: free-form names without timestamps",
  "description": null,
  "tier": "gnu",
  "tags": ["label"],
  "producer": {
    "tool": "diff",
    "version": "3.10",
    "argv": ["diff","-u","--label","before the change","--label","after the change","a/f.txt","b/f.txt"],
    "env": {}
  },
  "prefixes": {
    "old": "",
    "new": ""
  },
  "verified": {
    "replay": true,
    "git_raw_numstat": false,
    "git_apply_numstat": false
  },
  "text": {
    "diff_is_utf8": true,
    "names_are_utf8": true,
    "paths_inferable": false
  },
  "expected": {
    "files": [
      {
        "status": null,
        "old_name": "before the change",
        "new_name": "after the change",
        "old_path": "before the change",
        "new_path": "after the change",
        "old_mode": null,
        "new_mode": null,
        "similarity": null,
        "binary": false,
        "additions": 1,
        "deletions": 1,
        "hunks": [
          {
            "old_start": 1,
            "old_lines": 1,
            "new_start": 1,
            "new_lines": 1,
            "section": "",
            "lines": [
              {"type":"delete","text":"one","old_no":1,"new_no":null},
              {"type":"add","text":"two","old_no":null,"new_no":1}
            ]
          }
        ]
      }
    ]
  },
  "apply": {
    "skip": "the names are labels, not paths"
  },
  "recipe": {
    "kind": "gnu-diff",
    "args": [
      "-u",
      "--label",
      "before the change",
      "--label",
      "after the change"
    ],
    "file": "f.txt",
    "states": [
      {
        "message": "state 0",
        "files": [
          {"path":"f.txt","content":"one\n"}
        ]
      },
      {
        "message": "state 1",
        "files": [
          {"path":"f.txt","content":"two\n"}
        ]
      }
    ]
  },
  "source": "scenarios/90-gnu.js"
}
